* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.csv text eol=crlf
*.txt text eol=crlf
*.inc text eol=crlf
*.eug text eol=crlf
*.bmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.wav binary
*.mp3 binary

# Darkest Hour consumes legacy encodings and the installer verifies exact bytes.
mod/** -text
mod/** whitespace=cr-at-eol
